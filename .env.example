# Aplicação
APP_NAME=legis-service-estados
APP_ENV=development
LOG_LEVEL=info

# HTTP
USER_AGENT="LegalBot/1.0 (+contato@legalbot.com.br)"
HTTP_TIMEOUT_SECONDS=15

# Rate limit (multiplicador global, 1.0 = padrão)
RATE_LIMIT_FATOR=1.0

# Circuit breaker
CB_FAIL_THRESHOLD=5
CB_RESET_TIMEOUT_SECONDS=60

# Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=legis-service-estados
